# Response headers for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# Pages already sends X-Content-Type-Options and Referrer-Policy, so they are not repeated here.
#
# - Strict-Transport-Security: browsers remember to use HTTPS only, for a year.
# - Content-Security-Policy: only this site's own files may load. Inline scripts and styles are
#   needed by Next.js; the two cloudflareinsights hosts are Cloudflare Web Analytics.
# - X-Frame-Options / frame-ancestors: the site may not be shown inside another site's frame.
# - Permissions-Policy: the site uses no camera, microphone, location or payments.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Build files have the content hash in their name, so they never change and can be cached for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
